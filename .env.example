# ==========================================
# TIKTOK SHOP AI AUTOPILOT - ENVIRONMENT CONFIG
# ==========================================

# Execution Mode: DEMO | PRODUCTION
APP_ENV=DEMO
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
LOG_LEVEL=debug

# ==========================================
# SUPABASE / POSTGRESQL CONFIG
# ==========================================
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tiktok_autopilot
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ==========================================
# REDIS & BULLMQ CONFIG
# ==========================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_URL=redis://localhost:6379

# ==========================================
# TIKTOK SHOP API & OAUTH CONFIG
# ==========================================
TIKTOK_APP_KEY=your_tiktok_app_key
TIKTOK_APP_SECRET=your_tiktok_app_secret
TIKTOK_REDIRECT_URI=http://localhost:4000/api/v1/auth/tiktok/callback
TIKTOK_API_BASE_URL=https://open-api.tiktok.com
TIKTOK_SHOP_CIPHER=your_shop_cipher
TIKTOK_SHOP_ID=your_shop_id

# ==========================================
# AI PROVIDERS (LLM, Image, Video, TTS)
# ==========================================
# Primary LLM (OpenAI / Anthropic / Gemini)
AI_PROVIDER=mock
AI_PROVIDER_API_KEY=
AI_MODEL_NAME=gpt-4o-mini

# Image Generation Provider (Flux / Midjourney API / DALL-E)
IMAGE_PROVIDER=mock
IMAGE_PROVIDER_API_KEY=

# Video Generation Provider (Runway / Pika / Kling / Sora API / Mock)
VIDEO_PROVIDER=mock
VIDEO_PROVIDER_API_KEY=

# TTS Audio / Voice Provider (ElevenLabs / OpenAI TTS)
TTS_PROVIDER=mock
TTS_PROVIDER_API_KEY=

# ==========================================
# MEDIA PROCESSING & STORAGE
# ==========================================
STORAGE_PROVIDER=local
STORAGE_BUCKET_NAME=tiktok-autopilot-media
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# ==========================================
# BUDGET & AUTOPILOT LIMITS
# ==========================================
MAX_VIDEOS_PER_DAY=3
MAX_VARIATIONS_PER_PRODUCT=3
MAX_DAILY_AI_COST_USD=15.00
MAX_MONTHLY_AI_COST_USD=300.00
MIN_PRODUCT_SCORE_AUTOPILOT=75
AUTOPILOT_AUTO_PUBLISH=false
AUTOPILOT_EMERGENCY_STOP=false

# ==========================================
# SECURITY & SECRETS
# ==========================================
JWT_SECRET=super_secret_jwt_key_min_32_characters_random
ENCRYPTION_KEY=32_byte_hex_encryption_key_for_oauth_tokens_here!
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
