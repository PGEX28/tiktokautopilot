{
  "name": "03 - TikTok Live Loop 24/7 Streamer",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 1
            }
          ]
        }
      },
      "id": "node-cron-health",
      "name": "Hourly Live Stream Health Check",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{$env.API_BASE_URL || 'http://localhost:3000'}}/api/v1/live/status",
        "options": {}
      },
      "id": "node-check-live",
      "name": "Get Live Sessions Status",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [420, 300]
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{$json.status}}",
              "operation": "notEqual",
              "value2": "STREAMING"
            }
          ]
        }
      },
      "id": "node-if-stopped",
      "name": "If Stream Stopped",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [640, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.API_BASE_URL || 'http://localhost:3000'}}/api/v1/live/restart",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "{\n  \"loopForever\": true,\n  \"bitrateKbps\": 4500\n}",
        "options": {}
      },
      "id": "node-restart-live",
      "name": "Restart 24/7 RTMP Loop",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [880, 260]
    }
  ],
  "connections": {
    "Hourly Live Stream Health Check": {
      "main": [
        [
          {
            "node": "Get Live Sessions Status",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Get Live Sessions Status": {
      "main": [
        [
          {
            "node": "If Stream Stopped",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "If Stream Stopped": {
      "main": [
        [
          {
            "node": "Restart 24/7 RTMP Loop",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  }
}
